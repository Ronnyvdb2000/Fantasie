name: "Bot 01: FULL scanner (041-059) GARP onderwaardering (Hoogland) — wekelijks"

on:
  schedule:
    # Zaterdag 03:00 UTC — geen enkele beurs wereldwijd open (VS/Europa/Azië
    # allemaal in het weekend gesloten), en buiten de populaire ronde
    # cron-tijden waar GitHub Actions-jobs vaker in de wachtrij belanden.
    - cron: "0 3 * * 6"
  workflow_dispatch:

jobs:
  bot-01hoogl-full:
    runs-on: ubuntu-latest
    # Ruime marge: ~15.300 tickers over 19 beurzen kan meerdere uren duren.
    # Voorkomt dat een hangende run stilzwijgend tot de GH-default van 360
    # minuten doorloopt zonder dat er iets van te zien is.
    timeout-minutes: 300
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install yfinance pandas numpy requests python-dotenv psycopg2-binary
      - name: Run bot_01hoogl (full scan, a-lijsten, strenger)
        env:
          TELEGRAM_TOKEN:   ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          EMAIL_USER:       ${{ secrets.EMAIL_USER }}
          EMAIL_PASS:       ${{ secrets.EMAIL_PASS }}
          EMAIL_RECEIVER:   ${{ secrets.EMAIL_RECEIVER }}
          SUPABASE_DB_URL:  ${{ secrets.SUPABASE_DB_URL }}
        run: python bot_01hoogl.py full
